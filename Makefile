BUILDDIR ?= $(CURDIR)/build

###############################################################################
###                                  Build                                  ###
###############################################################################

BUILD_TARGETS := build install

build: BUILD_ARGS=-o $(BUILDDIR)/

$(BUILD_TARGETS): 
	go $@ $(BUILD_ARGS) ./.

###############################################################################
###                                Linting                                  ###
###############################################################################

lint:
	golangci-lint run --out-format=tab

###############################################################################
###                                Testing                                  ###
###############################################################################

TEST_PACKAGES=$(shell go list ./... | grep -v '/example-report$$')

test:
	go test -mod=readonly $(TEST_PACKAGES)

